[Unit]
Description=AdviceConnect MySaas backend API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adviceconnect
Group=adviceconnect
WorkingDirectory=/srv/adviceconnect/current/backend
EnvironmentFile=/etc/adviceconnect/backend.env
ExecStart=/usr/bin/node --no-warnings dist/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/adviceconnect /var/log/adviceconnect /srv/adviceconnect/current

[Install]
WantedBy=multi-user.target
