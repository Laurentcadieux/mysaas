[Unit]
Description=AdviceConnect MySaas frontend web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adviceconnect
Group=adviceconnect
WorkingDirectory=/srv/adviceconnect/current/frontend
EnvironmentFile=/etc/adviceconnect/frontend.env
ExecStart=/usr/bin/node server.mjs
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/srv/adviceconnect/current

[Install]
WantedBy=multi-user.target
